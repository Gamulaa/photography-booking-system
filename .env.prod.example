# PostgreSQL Production Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=photography_studio

# Application URL (match the port/domain users open in their browser)
FRONTEND_URL=http://localhost:8080
WEB_PORT=8080

# Set to true when serving over HTTPS (required for live production domains)
COOKIE_SECURE=false

# JWT Authentication (use a random 64-character secret)
JWT_SECRET=replace_with_a_unique_64_character_random_secret_key_for_production
JWT_EXPIRES_IN=7d

# Initial Admin Seed Account
ADMIN_NAME=Studio Administrator
ADMIN_EMAIL=admin@yourstudio.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Cloudinary Credentials (Required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret