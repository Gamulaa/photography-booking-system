NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photography_studio?schema=public"

# JWT Authentication
JWT_SECRET="replace-with-a-long-random-64-character-secret-key"
JWT_EXPIRES_IN="7d"

# Initial Admin Seed Credentials
ADMIN_NAME="Studio Administrator"
ADMIN_EMAIL="admin@studiolens.com"
ADMIN_PASSWORD="ChangeMe123!"

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"